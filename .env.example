# Copy to .env and use separate long random passwords for the database administrator
# and the application account. Keep .env private; it is ignored by Git.
POSTGRES_PASSWORD=JECih8lrRNJ8qcu8yOjGDJshzhjn07dbjbLO0gOG_BxBHtPU
BROKER_DB_PASSWORD=kqmqFi31kz-lbwX9EmNBw2q15rN1BaX_04BpMxL-g2e1ycws

# Safe default. Set OPENAI_BASE_URL, OPENAI_MODEL, and OPENAI_API_KEY only after
# deciding which OpenAI-compatible endpoint may receive event payloads.
LLM_PROVIDER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Bayora local prototype role tokens. Replace these with separate random values.
BAYORA_RED_TOKEN=bayora-red-local-demo
BAYORA_BLUE_TOKEN=bayora-blue-local-demo
BAYORA_EVALUATOR_TOKEN=bayora-evaluator-local-demo
BAYORA_BLUE_INTERNAL_TOKEN=replace_with_a_random_internal_service_token
BAYORA_WITNESS_TOKEN=replace_with_a_different_random_witness_ingest_token

# Optional real OpenAI-compatible target. Keep mock mode unless you deliberately
# configure an endpoint that is approved to receive the synthetic evaluation prompts.
BAYORA_MODEL_PROVIDER=mock
BAYORA_UPSTREAM_BASE_URL=http://host.docker.internal:11434/v1
BAYORA_UPSTREAM_MODEL=gpt-6-luna
BAYORA_UPSTREAM_API_KEY=
